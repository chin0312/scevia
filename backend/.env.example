# Copy to .env for local development. This token is a placeholder for local use only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://scevia:local-dev-only-change-me@127.0.0.1:5432/scevia
POSTGRES_DB=scevia
POSTGRES_USER=scevia
POSTGRES_PASSWORD=local-dev-only-change-me
AUTH_MODE=development
DEV_AUTH_TOKEN=replace-this-with-a-random-value-of-at-least-32-characters
DEV_PRINCIPAL_ID=00000000-0000-4000-8000-000000000001
CORS_ORIGINS=http://localhost:5173
DB_SSL=false

# Explicitly authorized loopback development only. No live calls by default.
KALSHI_PUBLIC_DATA_AUTHORIZED=NO
KALSHI_ACCOUNT_DATA_AUTHORIZED=NO
KALSHI_ENVIRONMENT=demo
# KALSHI_PROVIDER_ACCOUNT_ID=
# KALSHI_PORTFOLIO_ID=
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_FILE=/absolute/path/outside/repository

# Opt-in finalized Polygon pUSD wallet balance observations.
POLYMARKET_POLYGON_RPC_AUTHORIZED=NO
# POLYMARKET_POLYGON_RPC_URL=https://your-approved-polygon-rpc

# Owner-scoped backend demo using a permitted captured market dataset.
DEMO_CAPTURE_AUTHORIZED=NO
# DEMO_DATASET_PATH=/absolute/path/to/authorized-demo.json
# DEMO_DATASET_CACHE_MS=60000
