{
  "$description": "Scevia design tokens (W3C DTCG format). Single source of truth. Run `node design-system/tokens/build.mjs` to regenerate tokens.css. Primitives are private: components use semantic tokens only.",
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": {
          "$value": "#FFFFFF"
        },
        "50": {
          "$value": "#F4F5F7"
        },
        "300": {
          "$value": "#A8AEB8"
        },
        "500": {
          "$value": "#7E848F"
        },
        "800": {
          "$value": "#212328"
        },
        "850": {
          "$value": "#1A1B1F"
        },
        "900": {
          "$value": "#131417"
        },
        "950": {
          "$value": "#0D0E10"
        },
        "1000": {
          "$value": "#08090A"
        }
      },
      "alpha": {
        "white-04": {
          "$value": "#FFFFFF0A"
        },
        "white-07": {
          "$value": "#FFFFFF12"
        },
        "white-12": {
          "$value": "#FFFFFF1F"
        },
        "white-20": {
          "$value": "#FFFFFF33"
        },
        "black-60": {
          "$value": "#00000099"
        }
      },
      "violet": {
        "300": {
          "$value": "#BEB4FF"
        },
        "400": {
          "$value": "#9D8FFB"
        },
        "600": {
          "$value": "#6552DD"
        },
        "900": {
          "$value": "#1F1B38"
        }
      },
      "green": {
        "400": {
          "$value": "#3DD68C"
        },
        "900": {
          "$value": "#0E2A1E"
        }
      },
      "red": {
        "400": {
          "$value": "#FF6E64"
        },
        "900": {
          "$value": "#341614"
        }
      },
      "amber": {
        "400": {
          "$value": "#F0B54A"
        },
        "900": {
          "$value": "#302410"
        }
      },
      "blue": {
        "400": {
          "$value": "#5E8FF2"
        },
        "900": {
          "$value": "#142039"
        }
      },
      "teal": {
        "400": {
          "$value": "#2FC4B2"
        }
      },
      "pink": {
        "400": {
          "$value": "#EC7FB4"
        }
      },
      "slate": {
        "400": {
          "$value": "#8E97A8"
        }
      },
      "brand": {
        "polymarket": {
          "$value": "#2E5CFF"
        },
        "kalshi": {
          "$value": "#00DD94"
        }
      }
    }
  },
  "theme": {
    "dark": {
      "$description": "The only theme. Matches the reference set (getquin, Delta): near-black canvas, stepped grey surfaces, one violet accent.",
      "color": {
        "$type": "color",
        "bg": {
          "canvas": {
            "$value": "{primitive.color.neutral.1000}"
          },
          "surface": {
            "$value": "{primitive.color.neutral.900}"
          },
          "raised": {
            "$value": "{primitive.color.neutral.850}"
          },
          "sunken": {
            "$value": "{primitive.color.neutral.950}"
          },
          "hover": {
            "$value": "{primitive.color.alpha.white-04}"
          },
          "selected": {
            "$value": "{primitive.color.violet.900}"
          },
          "overlay": {
            "$value": "{primitive.color.alpha.black-60}"
          }
        },
        "border": {
          "subtle": {
            "$value": "{primitive.color.alpha.white-07}"
          },
          "default": {
            "$value": "{primitive.color.alpha.white-12}"
          },
          "strong": {
            "$value": "{primitive.color.alpha.white-20}"
          }
        },
        "text": {
          "primary": {
            "$value": "{primitive.color.neutral.50}"
          },
          "secondary": {
            "$value": "{primitive.color.neutral.300}"
          },
          "tertiary": {
            "$value": "{primitive.color.neutral.500}"
          },
          "inverse": {
            "$value": "{primitive.color.neutral.1000}"
          }
        },
        "action": {
          "primary-bg": {
            "$value": "{primitive.color.neutral.0}"
          },
          "primary-fg": {
            "$value": "{primitive.color.neutral.1000}"
          },
          "secondary-bg": {
            "$value": "{primitive.color.neutral.800}"
          },
          "secondary-fg": {
            "$value": "{primitive.color.neutral.50}"
          }
        },
        "accent": {
          "solid": {
            "$value": "{primitive.color.violet.600}"
          },
          "fg": {
            "$value": "{primitive.color.violet.300}"
          },
          "bg": {
            "$value": "{primitive.color.violet.900}"
          },
          "on-solid": {
            "$value": "{primitive.color.neutral.0}"
          }
        },
        "gain": {
          "fg": {
            "$value": "{primitive.color.green.400}"
          },
          "bg": {
            "$value": "{primitive.color.green.900}"
          }
        },
        "loss": {
          "fg": {
            "$value": "{primitive.color.red.400}"
          },
          "bg": {
            "$value": "{primitive.color.red.900}"
          }
        },
        "warn": {
          "fg": {
            "$value": "{primitive.color.amber.400}"
          },
          "bg": {
            "$value": "{primitive.color.amber.900}"
          }
        },
        "info": {
          "fg": {
            "$value": "{primitive.color.blue.400}"
          },
          "bg": {
            "$value": "{primitive.color.blue.900}"
          }
        },
        "focus": {
          "ring": {
            "$value": "{primitive.color.violet.400}"
          }
        },
        "data": {
          "1": {
            "$value": "{primitive.color.blue.400}"
          },
          "2": {
            "$value": "{primitive.color.violet.400}"
          },
          "3": {
            "$value": "{primitive.color.teal.400}"
          },
          "4": {
            "$value": "{primitive.color.amber.400}"
          },
          "5": {
            "$value": "{primitive.color.pink.400}"
          },
          "6": {
            "$value": "{primitive.color.slate.400}"
          }
        },
        "platform": {
          "polymarket": {
            "$value": "{primitive.color.brand.polymarket}"
          },
          "kalshi": {
            "$value": "{primitive.color.brand.kalshi}"
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "overlay": {
          "$value": {
            "offsetX": "0px",
            "offsetY": "16px",
            "blur": "40px",
            "spread": "0px",
            "color": "{primitive.color.alpha.black-60}"
          }
        }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "0": {
      "$value": "0px"
    },
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "20px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "10": {
      "$value": "40px"
    },
    "12": {
      "$value": "48px"
    },
    "16": {
      "$value": "64px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "6px"
    },
    "md": {
      "$value": "10px"
    },
    "lg": {
      "$value": "14px"
    },
    "xl": {
      "$value": "20px"
    },
    "pill": {
      "$value": "999px"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Geist",
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "Geist Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    },
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": "11px"
      },
      "xs": {
        "$value": "12px"
      },
      "sm": {
        "$value": "13px"
      },
      "md": {
        "$value": "14px"
      },
      "lg": {
        "$value": "16px"
      },
      "xl": {
        "$value": "20px"
      },
      "2xl": {
        "$value": "24px"
      },
      "3xl": {
        "$value": "32px"
      },
      "display": {
        "$value": "48px"
      },
      "hero": {
        "$value": "60px"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.1
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      }
    },
    "tracking": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0em"
      },
      "caps": {
        "$value": "0.08em"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ]
      },
      "in": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "topbar-height": {
      "$value": "60px"
    },
    "rail-width": {
      "$value": "220px"
    },
    "content-max": {
      "$value": "1440px"
    },
    "control-height": {
      "$value": "34px"
    },
    "control-height-sm": {
      "$value": "28px"
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "sticky": {
      "$value": 20
    },
    "dropdown": {
      "$value": 40
    },
    "overlay": {
      "$value": 100
    },
    "toast": {
      "$value": 1000
    }
  }
